# Local development only. Copy this file to .env and fill in your own keys.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Primary requirement-analysis provider: gemini or nvidia
AI_PROVIDER=gemini
GEMINI_API_KEY=

# NVIDIA NIM alternative provider
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# Optional legacy Ollama integration (only if you use those endpoints)
OLLAMA_API_KEY=
OLLAMA_MODEL=nemotron-3-super
